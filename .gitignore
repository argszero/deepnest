# Rust
/target/
**/*.rs.bk
*.pdb

# Node / front end
node_modules/
dist/
*.tsbuildinfo

# The toolchain archive the release pipeline packs and the build embeds. A build input, never a
# source file: it is tens of megabytes, and `git add -A` after a payload build must not take it.
/payload/

# Local app data and runtimes unpacked by deepnest
/.deepnest/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
